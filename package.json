{
  "name": "@crowdstrike/strands-aidr",
  "version": "0.1.0",
  "description": "CrowdStrike AIDR integration for the Strands Agents SDK (TypeScript)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowdStrike/aidr-strands-typescript.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm,cjs && tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowdstrike/aidr": ">=1.0.0"
  },
  "peerDependencies": {
    "@strands-agents/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
